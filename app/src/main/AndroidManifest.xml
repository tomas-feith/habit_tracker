<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".HabitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HabitTracker">

        <!--
            singleTop, not the default "standard": the whole app is one activity hosting a
            Compose back stack, so a second instance means a second, empty back stack.

            Tapping the launcher icon while the app is already running sends
            MAIN/LAUNCHER with FLAG_ACTIVITY_NEW_TASK, and under "standard" that creates a
            fresh MainActivity on top of the existing one. The old instance is still there
            with its navigation intact, but you are now looking at a new one that starts at
            the home screen - so leaving a half-written habit and coming back appeared to
            throw the edit screen away.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.HabitTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.HabitWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Midnight rollover: nothing writes to the database when the date
                     changes, so without these the widget keeps showing yesterday. -->
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <!--
            Alarms are dropped by the system for several reasons the app never hears about,
            and an alarm armed for an absolute instant is simply wrong once the wall clock
            moves under it. Each of these puts every reminder back.
        -->
        <receiver
            android:name=".notify.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Alarms do not survive an app update either, and nothing else would
                     re-arm them until the user next edited a habit. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- Rebuilds the whole chain of one-shot alarms once a day, so a re-arm
                     lost to the process being killed mid-broadcast costs one nudge rather
                     than every nudge from then on. -->
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
